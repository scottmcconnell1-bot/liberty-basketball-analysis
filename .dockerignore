# ── Liberty Basketball Analysis – .dockerignore ────────────────────────
# Keeps the Docker image lean: only production code enters the image.

# Experiment / research scripts (not needed at runtime)
experiments/

# Python cache
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/

# Virtual environments
.venv/
venv/
env/

# IDE
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# Git
.git/
.gitignore

# Uploaded videos (mounted as a volume at runtime)
uploads/*.mp4
uploads/*.avi
uploads/*.mov
uploads/*.mkv

# SQLite DB (mounted as a volume at runtime)
film_analysis.db

# Generated output directories (never needed in image)
pipeline_output/
hoop_vis/
motion_vis/
motion_vis_mid/
pretrained_test_output/
sample_frames*/
ball_dataset*/
ball_finetune/
weights_ameer/
*__vis/
logs/

# Generated media
*.mp4

# Docs / planning (not needed at runtime)
docs/

# Tests (not needed in production image)
tests/

# Playwright / test artifacts
*.log
transfer-bundles/
*.tar.gz

# Extra/non-essential
EXTRA/
