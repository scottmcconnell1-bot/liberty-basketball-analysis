import json
from pathlib import Path

# Configuration
TAGS_PATH = Path(r"C:\Users\scott\Documents\liberty-basketball-analysis\data\film_tags\jrhigh_notus_LIBERTY_H_v_NOTUS_A1_20260809_221334.json")
TRACKS_PATH = Path(r"C:\Users\scott\AppData\Local\Temp\v6_tracks.json") # Update to current v6 path

def clock_ms(text):
    minutes, seconds = str(text).split(":")
    return int(round((int(minutes) * 60 + float(seconds)) * 1000))

def main():
    print("--- Notus 7 Missed Makes: Path Audit ---")
    
    try:
        with open(TAGS_PATH, 'r') as f:
            tags_data = json.load(f)
        with open(TRACKS_PATH, 'r') as f:
            tracks_data = json.load(f)
    except FileNotFoundError as e:
        print(f"Error: Could not find file: {e}")
        return

    track_by_time = {t['t']: t for t in tracks_data}
    
    # Identify the 7 missed makes based on your input
    # Notus missed makes: 1:04.2, 2:22.6, 2:39.3, 5:57.5, 3:32.3, 8:03.4, 12:54.6
    failure_times = [
        "1:04.2", "2:22.6", "2:39.3", "5:57.5", "3:32.3", "8:03.4", "12:54.6"
    ]
    
    for time_str in failure_times:
        ts = clock_ms(time_str)
        print(f"\nAnalyzing Shot at {time_str} (TS: {ts}ms)")
        
        if ts not in track_by_time:
            print(f"  [!] No track found for this timestamp in v6_tracks.json")
            continue
            
        track = track_by_time[ts]
        hoop = track.get('hoop', [])
        ball = track.get('ball', [])
        bodd = track.get('bodd', [])
        
        if not hoop:
            print("  [!] No hoop data available.")
            continue
            
        hx, hy, hw, ha = hoop
        print(f"  Hoop: X={hx}, Y={hy}, W={hw}")
        
        if not ball:
            print("  [!] Ball track is empty.")
            continue

        # Audit Ball Track
        print("  Ball Track Audit:")
        max_jump = 0
        gaps = 0
        for i in range(1, len(ball)):
            # Gap detection (frame difference)
            frame_gap = ball[i][0] - ball[i-1][0]
            if frame_gap > 1:
                gaps += 1
                
            # Jump detection (spatial distance)
            dist = ((ball[i][1]-ball[i-1][1])**2 + (ball[i][2]-ball[i-1][2])**2)**0.5
            max_jump = max(max_jump, dist)
        
        print(f"    Total points: {len(ball)}")
        print(f"    Max spatial jump: {max_jump:.2f}px")
        print(f"    Frame gaps: {gaps}")
        
        # Crossing Audit
        crossed = False
        for pt in ball:
            if pt[2] >= hy:
                # Check if it was above in the previous point
                # (Simplified for this audit)
                crossed = True
                break
        
        print(f"    Crossed hoop_y ({hy}): {'Yes' if crossed else 'No'}")
        
        # Column check
        in_column = sum(1 for pt in ball if abs(pt[1] - hx) <= 0.55 * hw)
        print(f"    Points in 0.55w column: {in_column}/{len(ball)}")

if __name__ == "__main__":
    main()
