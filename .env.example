# Liberty Basketball — environment secrets (copy to .env locally; never commit .env)

# Flask session signing (required for production)
SECRET_KEY=

# Browser push (optional until notifications go live)
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=

# Email notifications (optional)
SMTP_SERVER=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# Database / uploads (optional overrides)
LIBERTY_DATABASE=film_analysis.db
LIBERTY_UPLOAD_FOLDER=uploads

# Shared coach-portal password for /coach (read-only coach view). Unset = gate disabled.
LIBERTY_COACH_PASSWORD=

# Flask debug mode for `python app.py` (never on a server or a 0.0.0.0 bind)
LIBERTY_DEBUG=0

# Development only — silences the startup warning when SECRET_KEY is unset and the
# committed dev fallback key is in use. Never set this on a networked machine.
# LIBERTY_ALLOW_DEV_SECRET=1
